<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="PasswordValidator Suite" verbose="1">

    <!-- Full test run — every group-->
    <test name="All tests">
        <classes>
            <class name="passwordvalidator.testng.PasswordValidatorTestNGTest"/>
        </classes>
    </test>

    <!-- Smoke tests only — quick sanity check-->
    <test name="Smoke tests only">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="passwordvalidator.testng.PasswordValidatorTestNGTest"/>
        </classes>
    </test>

    <!-- Negative scenarios — everything that expects validation errors -->
    <test name="Negative scenarios">
        <groups>
            <run>
                <include name="negative"/>
            </run>
        </groups>
        <classes>
            <class name="passwordvalidator.testng.PasswordValidatorTestNGTest"/>
        </classes>
    </test>

</suite>